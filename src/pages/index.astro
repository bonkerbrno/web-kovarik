---
import Layout from '@/layouts/Layout.astro';
import FiveToTwelveClock from '@/components/FiveToTwelveClock.astro';
import { getCollection } from 'astro:content';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.homepage.read();

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout
  title="Procesy, automatizace a AI pro firmy, obce a neziskovky"
  description="Pomáhám firmám, OSVČ, obcím a neziskovkám zbavit se zbytečné ruční práce: rozbor postupů, automatizace a rozumné využití AI."
>
  <!-- Hero -->
  <section class="section bg-gradient-to-br from-mist-100 via-mist-50 to-ivory">
    <div class="container text-center">
      <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-4">{home?.heroEyebrow}</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold text-slate-900 leading-tight mb-6">
        {home?.heroTitleLine1}<br class="hidden sm:block" />
        <span class="text-brand-500">{home?.heroTitleLine2}</span>
      </h1>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed">
        {home?.heroText}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/kontakt" class="btn-primary text-lg px-8 py-4">
          {home?.heroCtaPrimary}
        </a>
        <a href="/sluzby" class="btn-outline text-lg px-8 py-4">
          {home?.heroCtaSecondary}
        </a>
      </div>
    </div>
  </section>

  <!-- Problémy, které řeším -->
  <section class="section bg-ivory">
    <div class="container">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-slate-900 mb-4">{home?.problemsTitle}</h2>
        <p class="text-slate-500 text-lg">{home?.problemsSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {(home?.problems ?? []).map(({ icon, title, desc }) => (
          <div class="card relative group" data-clock-tile>
            <FiveToTwelveClock />
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="font-heading font-bold text-lg text-slate-900 mb-2">{title}</h3>
            <p class="text-slate-600 text-[15px] leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Služby přehled -->
  <section class="section bg-gradient-to-b from-mist-100 to-mist-50">
    <div class="container">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-slate-900 mb-4">{home?.servicesTitle}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {(home?.services ?? []).map(({ icon, title, desc, href }) => (
          <a href={href} class="card group p-6 hover:border-accent-400/40 hover:shadow-accent-500/30">
            <div class="text-3xl mb-3">{icon}</div>
            <h3 class="font-heading font-bold text-lg text-slate-900 mb-2 group-hover:text-brand-600 transition-colors">{title}</h3>
            <p class="text-slate-600 text-[15px] leading-relaxed mb-3">{desc}</p>
            <span class="text-brand-500 text-sm font-semibold">Více info →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- O mně zkratka -->
  <section class="section bg-ivory">
    <div class="container">
      <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-center gap-10">
        <img
          src="/stan-kovarik.jpg"
          alt="Stan Kovařík"
          width="128"
          height="128"
          loading="lazy"
          class="w-32 h-32 rounded-full object-cover bg-mist-200 flex-shrink-0"
        />
        <div>
          <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-2">{home?.aboutEyebrow}</p>
          <h2 class="text-2xl font-heading font-bold text-slate-900 mb-3">{home?.aboutName}</h2>
          <p class="text-slate-600 leading-relaxed mb-4">
            {home?.aboutText}
          </p>
          <a href="/o-mne" class="text-brand-500 font-semibold hover:text-brand-700 transition-colors">
            {home?.aboutLinkText}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Poslední články z blogu -->
  {posts.length > 0 && (
    <section class="section bg-gradient-to-b from-mist-100 to-mist-50">
      <div class="container">
        <div class="flex items-center justify-between mb-10">
          <h2 class="text-3xl font-heading font-bold text-slate-900">Z blogu</h2>
          <a href="/blog" class="text-brand-500 font-semibold hover:text-brand-700 transition-colors">Všechny články →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="card group">
              <div class="flex flex-wrap gap-2 mb-3">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="text-xs bg-mist-100 text-brand-700 px-2 py-1 rounded-full font-medium">{tag}</span>
                ))}
              </div>
              <h3 class="font-heading font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors leading-snug">
                {post.data.title}
              </h3>
              <p class="text-slate-600 text-[15px] leading-relaxed mb-4 line-clamp-3">{post.data.description}</p>
              <p class="text-xs text-slate-400">
                {post.data.pubDate.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section bg-gradient-to-br from-dusk-600 to-dusk-500">
    <div class="container text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-ivory mb-4">{home?.ctaTitle}</h2>
      <p class="text-ivory text-lg mb-8 max-w-xl mx-auto">
        {home?.ctaText}
      </p>
      <a href="/kontakt" class="inline-flex items-center gap-2 px-8 py-4 bg-ivory-50 text-dusk-600 font-bold rounded-xl hover:bg-mist-50 transition-colors shadow-lg shadow-slate-900/15 text-lg">
        {home?.ctaButton}
      </a>
    </div>
  </section>
</Layout>
