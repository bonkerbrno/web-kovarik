---
import Layout from '@/layouts/Layout.astro';
import LineIcon from '@/components/LineIcon.astro';
import FiveToTwelveClock from '@/components/FiveToTwelveClock.astro';
import FlowDiagram from '@/components/FlowDiagram.astro';
import { getCollection } from 'astro:content';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.homepage.read();

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout
  title="Procesy, automatizace a AI pro firmy, obce a neziskovky"
  description="Pomáháme firmám, OSVČ, obcím a neziskovkám zbavit se zbytečné ruční práce: rozbor postupů, automatizace a rozumné využití AI."
>
  <!-- Hero -->
  <section class="section bg-hero-blue">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_.9fr] gap-10 lg:gap-12 items-center">
        <div>
          <span class="inline-block bg-marker text-ink font-semibold text-xs sm:text-sm uppercase tracking-widest px-3 py-1.5 rounded-full mb-5">{home?.heroEyebrow}</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold leading-[1.05] mb-6">
            {home?.heroTitleLine1}<br class="hidden sm:block" />
            <span class="hl">{home?.heroTitleLine2}</span>
          </h1>
          <p class="text-lg sm:text-xl max-w-xl mb-8 leading-relaxed">
            {home?.heroText}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 items-start sm:items-center">
            <a href="/kontakt" class="btn-light w-full sm:w-auto">
              {home?.heroCtaPrimary}
            </a>
            <a href="/sluzby" class="inline-flex items-center min-h-12 px-2 text-ivory font-semibold underline underline-offset-4 decoration-marker decoration-[3px] hover:text-marker transition-colors">
              {home?.heroCtaSecondary}
            </a>
          </div>
          {home?.heroCtaNote && <p class="text-sm mt-4 max-w-xl">{home.heroCtaNote}</p>}
          <ul class="flex flex-wrap gap-2 mt-7">
            {(home?.heroChips ?? []).map((chip) => (
              <li class="text-sm px-3 py-1 rounded-full border border-dashed border-ivory/50 bg-ivory/10">{chip}</li>
            ))}
          </ul>
        </div>
        <div class="min-w-0">
          <FlowDiagram />
        </div>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-12">
        {(home?.audiences ?? []).map(({ title, desc, href }) => (
          <li>
            <a href={href} class="block h-full border-2 border-ivory rounded-2xl px-4 py-3 hover:bg-ivory/10 transition-colors">
              <span class="block font-heading font-bold text-lg text-marker">{title}</span>
              <span class="block text-sm text-ivory/85">{desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Problémy, které řeším -->
  <section class="section bg-ivory">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">{home?.problemsTitle}</h2>
        <p class="text-slate-500 text-lg">{home?.problemsSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {(home?.problems ?? []).slice(0, 3).map(({ icon, title, desc }) => (
          <div class="card card-tint card-burn relative group" data-clock-tile>
            <FiveToTwelveClock />
            <LineIcon name={icon} class="icon-chip" />
            <h3 class="font-heading font-bold text-lg text-navy mb-2">{title}</h3>
            <p class="text-slate-600 text-[15px] leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      {(home?.problems ?? []).length > 3 && (
        <details class="more mt-8">
          <summary>{home?.problemsMoreLabel ?? 'Další situace'}</summary>
          <div class="more-body grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {(home?.problems ?? []).slice(3).map(({ icon, title, desc }) => (
          <div class="card card-tint card-burn relative group" data-clock-tile>
            <FiveToTwelveClock />
            <LineIcon name={icon} class="icon-chip" />
            <h3 class="font-heading font-bold text-lg text-navy mb-2">{title}</h3>
            <p class="text-slate-600 text-[15px] leading-relaxed">{desc}</p>
          </div>
        ))}
          </div>
        </details>
      )}
    </div>
  </section>

  <!-- Služby přehled -->
  <section class="section bg-stripe-blue">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">{home?.servicesTitle}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {(home?.services ?? []).map(({ icon, title, desc, href, linkText }) => (
          <a href={href} class="card card-tint group hover:border-brand-200">
            <LineIcon name={icon} class="icon-chip" />
            <h3 class="font-heading font-bold text-lg text-navy mb-2 group-hover:text-brand-600 transition-colors">{title}</h3>
            <p class="text-slate-600 text-[15px] leading-relaxed mb-3">{desc}</p>
            <span class="text-brand-700 text-sm font-semibold underline decoration-marker decoration-[3px] underline-offset-4">{linkText || 'Více info →'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Jak to probíhá -->
  {(home?.steps ?? []).length > 0 && (
    <section class="section bg-ivory">
      <div class="container">
        <div class="text-center mb-10">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy">{home?.stepsTitle}</h2>
        </div>
        <ol class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {(home?.steps ?? []).map(({ title, desc }, i) => (
            <li class="relative pl-14">
              <span class="absolute left-0 top-0 w-10 h-10 rounded-full bg-marker text-ink ring-2 ring-ink font-heading font-extrabold text-lg flex items-center justify-center" aria-hidden="true">{i + 1}</span>
              <h3 class="font-heading font-bold text-lg text-navy mb-2">{title}</h3>
              <p class="text-slate-600 text-[15px] leading-relaxed">{desc}</p>
            </li>
          ))}
        </ol>
        <div class="text-center mt-10">
          <a href="/kontakt" class="btn-primary">{home?.heroCtaPrimary}</a>
        </div>
      </div>
    </section>
  )}

  <!-- O mně zkratka -->
  <section class="section bg-stripe-blue">
    <div class="container">
      <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-center gap-10">
        <img
          src="/stan-kovarik.jpg"
          alt="Ing. Stanislav Kovařík"
          width="128"
          height="128"
          loading="lazy"
          class="w-32 h-32 rounded-full object-cover bg-mist-200 flex-shrink-0"
        />
        <div>
          <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-2">{home?.aboutEyebrow}</p>
          <h2 class="text-2xl font-heading font-bold text-navy mb-3">{home?.aboutName}</h2>
          <p class="text-slate-600 leading-relaxed mb-4">
            {home?.aboutText}
          </p>
          <a href="/o-mne" class="text-brand-500 font-semibold hover:text-brand-700 transition-colors">
            {home?.aboutLinkText}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Poslední články z blogu -->
  {posts.length > 0 && (
    <section class="section bg-ivory">
      <div class="container">
        <div class="flex items-center justify-between mb-10">
          <h2 class="text-3xl font-heading font-bold text-navy">Z blogu</h2>
          <a href="/blog" class="text-brand-500 font-semibold hover:text-brand-700 transition-colors">Všechny články →</a>
        </div>
        <div class={`grid grid-cols-1 gap-6 ${
          posts.length === 1 ? 'max-w-2xl' : posts.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'
        }`}>
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="card card-tint group">
              <div class="flex flex-wrap gap-2 mb-3">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="text-xs bg-mist-100 text-brand-700 px-2 py-1 rounded-full font-medium">{tag}</span>
                ))}
              </div>
              <h3 class="font-heading font-bold text-navy mb-2 group-hover:text-brand-600 transition-colors leading-snug">
                {post.data.title}
              </h3>
              <p class="text-slate-600 text-[15px] leading-relaxed mb-4 line-clamp-3">{post.data.description}</p>
              <p class="text-xs text-slate-400">
                {post.data.pubDate.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section cta-band">
    <div class="container text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-extrabold mb-4">{home?.ctaTitle}</h2>
      <p class="text-lg mb-8 max-w-xl mx-auto">
        {home?.ctaText}
      </p>
      <a href="/kontakt" class="btn-light">
        {home?.ctaButton}
      </a>
    </div>
  </section>
</Layout>
