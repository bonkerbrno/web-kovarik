---
import Layout from '@/layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.kontakt.read();
---

<Layout
  title="Kontakt"
  description="Domluvte si bezplatnou konzultaci. Napište mi na e-mail nebo vyplňte kontaktní formulář."
>
  <section class="section bg-gradient-to-br from-brand-50 to-white">
    <div class="container text-center">
      <h1 class="text-4xl sm:text-5xl font-heading font-bold text-gray-900 mb-4">{page?.heroTitle}</h1>
      <p class="text-xl text-gray-500 max-w-xl mx-auto">
        {page?.heroText}
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 max-w-5xl mx-auto">
        <!-- Formulář -->
        <div>
          <h2 class="text-2xl font-heading font-bold text-gray-900 mb-6">{page?.formTitle}</h2>
          <form
            name="kontakt"
            method="POST"
            data-netlify="true"
            class="space-y-5"
          >
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">Jméno a příjmení *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
                placeholder="Jan Novák"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">E-mail *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
                placeholder="jan@firma.cz"
              />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-gray-700 mb-1.5">Firma</label>
              <input
                type="text"
                id="company"
                name="company"
                class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
                placeholder="Firma s.r.o."
              />
            </div>
            <div>
              <label for="topic" class="block text-sm font-medium text-gray-700 mb-1.5">O co máte zájem?</label>
              <select
                id="topic"
                name="topic"
                class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow bg-white"
              >
                <option value="">Vyberte téma...</option>
                {(page?.topics ?? []).map(({ value, label }) => (
                  <option value={value}>{label}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1.5">Zpráva *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow resize-none"
                placeholder="Popište vaši situaci nebo otázku..."
              ></textarea>
            </div>
            <button type="submit" class="btn-primary w-full justify-center text-base py-3.5">
              {page?.submitButton}
            </button>
          </form>
        </div>

        <!-- Kontaktní info -->
        <div>
          <h2 class="text-2xl font-heading font-bold text-gray-900 mb-6">{page?.contactTitle}</h2>
          <div class="space-y-6 mb-10">
            <a href={`mailto:${page?.email}`} class="card flex items-center gap-4 hover:border-brand-200 group">
              <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center text-2xl flex-shrink-0">✉</div>
              <div>
                <p class="text-xs text-gray-500 mb-0.5">E-mail</p>
                <p class="font-semibold text-gray-900 group-hover:text-brand-600 transition-colors">{page?.email}</p>
              </div>
            </a>
            <a href={page?.linkedinUrl} target="_blank" rel="noopener" class="card flex items-center gap-4 hover:border-brand-200 group">
              <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center text-2xl flex-shrink-0">🔗</div>
              <div>
                <p class="text-xs text-gray-500 mb-0.5">LinkedIn</p>
                <p class="font-semibold text-gray-900 group-hover:text-brand-600 transition-colors">{page?.linkedinLabel}</p>
              </div>
            </a>
          </div>

          <div class="bg-gray-50 rounded-2xl p-6">
            <h3 class="font-heading font-bold text-gray-900 mb-3">{page?.processTitle}</h3>
            <ol class="space-y-3">
              {(page?.processSteps ?? []).map((step, i) => (
                <li class="flex items-start gap-3 text-sm text-gray-600">
                  <span class="w-6 h-6 bg-brand-500 text-white rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">
                    {i + 1}
                  </span>
                  {step}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
