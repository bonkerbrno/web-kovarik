---
import Layout from '@/layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { CONTACT_WEBHOOK_URL } from '@/config/contact';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.kontakt.read();
---

<Layout
  title="Kontakt"
  description="Domluvte si bezplatnou konzultaci. Napište mi na e-mail nebo vyplňte kontaktní formulář."
>
  <section class="section bg-gradient-to-br from-mist-100 via-mist-50 to-ivory">
    <div class="container text-center">
      <h1 class="text-4xl sm:text-5xl font-heading font-bold text-slate-900 mb-4">{page?.heroTitle}</h1>
      <p class="text-xl text-slate-500 max-w-xl mx-auto">
        {page?.heroText}
      </p>
    </div>
  </section>

  <section class="section bg-ivory">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 max-w-5xl mx-auto">
        <!-- Formulář -->
        <div>
          <h2 class="text-2xl font-heading font-bold text-slate-900 mb-6">{page?.formTitle}</h2>
          <form
            name="kontakt"
            data-contact-form
            data-endpoint={CONTACT_WEBHOOK_URL}
            data-email={page?.email}
            class="space-y-5"
          >
            <div class="hidden" aria-hidden="true">
              <label for="website">Toto pole nevyplňujte</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <div>
              <label for="name" class="block text-sm font-medium text-slate-700 mb-1.5">Jméno a příjmení *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 bg-ivory-50 border border-mist-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
                placeholder="Jan Novák"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">E-mail *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 bg-ivory-50 border border-mist-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
                placeholder="jan@email.cz"
              />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-slate-700 mb-1.5">Firma / organizace</label>
              <input
                type="text"
                id="company"
                name="company"
                class="w-full px-4 py-3 bg-ivory-50 border border-mist-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
                placeholder="Firma s.r.o., obec, spolek…"
              />
            </div>
            <div>
              <label for="topic" class="block text-sm font-medium text-slate-700 mb-1.5">O co máte zájem?</label>
              <select
                id="topic"
                name="topic"
                class="w-full px-4 py-3 bg-ivory-50 border border-mist-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
              >
                <option value="">Vyberte téma...</option>
                {(page?.topics ?? []).map(({ value, label }) => (
                  <option value={value}>{label}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-slate-700 mb-1.5">Zpráva *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 bg-ivory-50 border border-mist-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow resize-none"
                placeholder="Popište vaši situaci nebo otázku..."
              ></textarea>
            </div>
            <button type="submit" class="btn-primary w-full justify-center text-base py-3.5 disabled:opacity-60">
              {page?.submitButton}
            </button>
            <p data-form-status role="status" aria-live="polite" class="hidden"></p>
            <p class="text-xs text-slate-500">Údaje použiji jen k odpovědi na vaši zprávu.</p>
          </form>
        </div>

        <!-- Kontaktní info -->
        <div>
          <h2 class="text-2xl font-heading font-bold text-slate-900 mb-6">{page?.contactTitle}</h2>
          <div class="space-y-6 mb-10">
            <a href={`mailto:${page?.email}`} class="card flex items-center gap-4 hover:border-brand-200 group">
              <div class="w-12 h-12 bg-mist-100 rounded-xl flex items-center justify-center text-2xl flex-shrink-0">✉</div>
              <div>
                <p class="text-xs text-slate-500 mb-0.5">E-mail</p>
                <p class="font-semibold text-slate-900 group-hover:text-brand-600 transition-colors">{page?.email}</p>
              </div>
            </a>
            <a href={page?.linkedinUrl} target="_blank" rel="noopener" class="card flex items-center gap-4 hover:border-brand-200 group">
              <div class="w-12 h-12 bg-mist-100 rounded-xl flex items-center justify-center text-2xl flex-shrink-0">🔗</div>
              <div>
                <p class="text-xs text-slate-500 mb-0.5">LinkedIn</p>
                <p class="font-semibold text-slate-900 group-hover:text-brand-600 transition-colors">{page?.linkedinLabel}</p>
              </div>
            </a>
          </div>

          <div class="bg-slate-50 rounded-2xl p-6">
            <h3 class="font-heading font-bold text-slate-900 mb-3">{page?.processTitle}</h3>
            <ol class="space-y-3">
              {(page?.processSteps ?? []).map((step, i) => (
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <span class="w-6 h-6 bg-brand-500 text-white rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">
                    {i + 1}
                  </span>
                  {step}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const topic = form.querySelector<HTMLSelectElement>('#topic')!;
    const endpoint = form.dataset.endpoint ?? '';
    const email = form.dataset.email ?? '';

    const show = (text: string, ok: boolean) => {
      status.textContent = text;
      status.className = `text-sm ${ok ? 'text-accent-600' : 'text-red-600'}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      data.set('topic', topic.value ? topic.selectedOptions[0].text : '');

      // Bots fill the hidden field; pretend success and send nothing.
      if (data.get('website')) {
        form.reset();
        show('Děkuji, zpráva odešla.', true);
        return;
      }

      if (!endpoint) {
        const body = [
          `Jméno: ${data.get('name')}`,
          `Firma / organizace: ${data.get('company') || '—'}`,
          `Téma: ${data.get('topic') || '—'}`,
          '',
          String(data.get('message')),
        ].join('\n');
        window.location.href = `mailto:${email}?subject=${encodeURIComponent('Dotaz z webu kovarik.us')}&body=${encodeURIComponent(body)}`;
        return;
      }

      button.disabled = true;
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new URLSearchParams(data as unknown as Record<string, string>),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.reset();
        show('Děkuji, zpráva odešla. Ozvu se do 24 hodin.', true);
      } catch {
        show(`Zprávu se nepodařilo odeslat. Napište mi prosím přímo na ${email}.`, false);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
