---
import Layout from '@/layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.oMne.read();
---

<Layout
  title="O mně"
  description="Stan Kovařík — přes 15 let v manažerských rolích, specialista na procesní optimalizaci, n8n automatizace a AI implementaci."
>
  <!-- Hero -->
  <section class="section bg-gradient-to-br from-mist-100 via-mist-50 to-ivory">
    <div class="container">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center gap-12">
        <div class="w-40 h-40 rounded-full bg-mist-200 flex items-center justify-center text-7xl flex-shrink-0 shadow-lg shadow-mist-400/30">
          👤
        </div>
        <div>
          <p class="text-accent-600 font-semibold text-sm uppercase tracking-widest mb-3">O mně</p>
          <h1 class="text-4xl font-heading font-bold text-slate-900 mb-4">Stan Kovařík</h1>
          <p class="text-xl text-slate-500 mb-2">{page?.subtitle}</p>
          <p class="text-slate-500">{page?.locationText}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Příběh -->
  <section class="section bg-ivory">
    <div class="container max-w-3xl">
      <h2 class="text-3xl font-heading font-bold text-slate-900 mb-6">{page?.storyTitle}</h2>
      <div class="prose prose-lg text-slate-600 space-y-5">
        {(page?.storyParagraphs ?? []).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Zkušenosti -->
  <section class="section bg-gradient-to-b from-mist-100 to-mist-50">
    <div class="container max-w-3xl">
      <h2 class="text-3xl font-heading font-bold text-slate-900 mb-10">{page?.experienceTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-12">
        {(page?.experience ?? []).map(({ icon, title, desc }) => (
          <div class="card">
            <div class="text-3xl mb-3">{icon}</div>
            <h3 class="font-heading font-bold text-slate-900 mb-2">{title}</h3>
            <p class="text-slate-600 text-[15px] leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>

      <!-- Nástroje -->
      <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">{page?.toolsTitle}</h3>
      <div class="flex flex-wrap gap-2">
        {(page?.tools ?? []).map((tool) => (
          <span class="px-3 py-1.5 bg-ivory-50 border border-mist-200 rounded-lg text-sm text-slate-700 font-medium shadow-sm shadow-mist-400/20">
            {tool}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-gradient-to-br from-dusk-600 to-dusk-500">
    <div class="container text-center">
      <h2 class="text-3xl font-heading font-bold text-ivory mb-4">{page?.ctaTitle}</h2>
      <p class="text-ivory text-lg mb-8 max-w-xl mx-auto">
        {page?.ctaText}
      </p>
      <a href="/kontakt" class="inline-flex items-center gap-2 px-8 py-4 bg-ivory-50 text-dusk-600 font-bold rounded-xl hover:bg-mist-50 transition-colors shadow-lg shadow-slate-900/15 text-lg">
        {page?.ctaButton}
      </a>
    </div>
  </section>
</Layout>
