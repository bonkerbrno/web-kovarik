---
const navItems = [
  { href: '/', label: 'Domů' },
  { href: '/sluzby', label: 'Consulting' },
  { href: '/edu', label: 'Edu' },
  { href: '/blog', label: 'Blog' },
  { href: '/kontakt', label: 'Kontakt' },
];
// Built pages have a trailing slash ("/o-mne/"); sub-pages ("/blog/…") highlight their section.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/');
---

<header class="sticky top-0 z-50 bg-ivory/95 backdrop-blur-sm border-b border-mist-200/70 shadow-sm shadow-mist-400/10">
  <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[84px]">
      <!-- Logo -->
      <a href="/" class="flex items-center hover:opacity-80 transition-opacity">
        <img
          src="/logo-header.png"
          alt="be-agile – Processes, Automation, AI, Education"
          width="247"
          height="56"
          class="h-10 sm:h-14 w-auto"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class={`px-4 py-2 rounded-lg text-[15px] font-medium whitespace-nowrap transition-colors duration-150 ${
              isActive(href)
                ? 'bg-mist-100 text-brand-700'
                : 'text-slate-700 hover:text-brand-700 hover:bg-mist-50'
            }`}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2 rounded-lg text-slate-600 hover:text-brand-600 hover:bg-mist-50 transition-colors"
        aria-label="Otevřít menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden pb-4">
      <nav class="flex flex-col gap-1">
        {navItems.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class={`px-4 py-3 rounded-lg text-base font-medium transition-colors ${
              isActive(href)
                ? 'bg-mist-100 text-brand-700'
                : 'text-slate-700 hover:text-brand-700 hover:bg-mist-50'
            }`}
          >
            {label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
